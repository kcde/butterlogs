# Copy to .env.local and fill in (M0). Never commit .env.local.

# Supabase: Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. For `npm run test:db` and the one-off spreadsheet load (M9). Never expose to the browser.
SUPABASE_SECRET_KEY=
# Local only, for the Supabase CLI (migrations). Account → Access Tokens. Not needed on Vercel.
SUPABASE_ACCESS_TOKEN=

# PowerSync: instance URL from the PowerSync dashboard
NEXT_PUBLIC_POWERSYNC_URL=

# Sentry
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
